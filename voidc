#!/usr/bin/env bash
# voidc — fast, clean text-based installer for Void Linux.
# Usage: voidc [--auto profile.conf] [--target /mnt] [--check] [--version]
set -u

VOIDC_VERSION="1.1.0"
VOIDC_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
: "${TARGET:=/mnt}"
: "${LOGFILE:=/tmp/voidc-$(date +%Y%m%d-%H%M%S).log}"
export VOIDC_VERSION VOIDC_DIR TARGET LOGFILE

# ------------------------------------------------------------------ libs ----
# shellcheck source=lib/common.sh
. "$VOIDC_DIR/lib/common.sh"
# shellcheck source=lib/detect.sh
. "$VOIDC_DIR/lib/detect.sh"
# shellcheck source=lib/desktop.sh
. "$VOIDC_DIR/lib/desktop.sh"
# shellcheck source=lib/install.sh
. "$VOIDC_DIR/lib/install.sh"
# shellcheck source=lib/partition.sh
. "$VOIDC_DIR/lib/partition.sh"
# shellcheck source=lib/configure.sh
. "$VOIDC_DIR/lib/configure.sh"
# shellcheck source=lib/boot.sh
. "$VOIDC_DIR/lib/boot.sh"
# shellcheck source=lib/rice.sh
. "$VOIDC_DIR/lib/rice.sh"
# shellcheck source=lib/rice-wayland.sh
. "$VOIDC_DIR/lib/rice-wayland.sh"
# shellcheck source=lib/wizard.sh
. "$VOIDC_DIR/lib/wizard.sh"
# shellcheck source=lib/auto.sh
. "$VOIDC_DIR/lib/auto.sh"

usage() {
  cat <<EOF
voidc $VOIDC_VERSION — fast, clean text-based installer for Void Linux

Usage:
  voidc                      interactive TUI wizard (run from Void live ISO)
  voidc --auto <profile>     unattended install (see profiles/i3.conf)
  voidc --check              environment report, no changes
  voidc --target <dir>       install below <dir> (default: /mnt)

Options:
  -h, --help                 this help
  -v, --version              version
EOF
}

# _lexical_realpath <abs-path> -> normalised path without touching the
# filesystem. `readlink -f` returns nothing for paths that do not exist yet
# (and busybox only resolves existing paths), so fall back to this.
_lexical_realpath() {
  local p="$1" comp
  local -a stack=() parts=()
  local IFS='/'
  read -r -a parts <<<"$p"
  for comp in "${parts[@]}"; do
    case "$comp" in
      ''|.) continue ;;
      ..)   [ "${#stack[@]}" -gt 0 ] && unset 'stack[${#stack[@]}-1]' ;;
      *)    stack+=("$comp") ;;
    esac
  done
  if [ "${#stack[@]}" -eq 0 ]; then printf '/\n'
  else printf '/%s\n' "${stack[*]}"; fi
}

# guard_target — refuse dangerous --target values. The installer wipes and
# mounts TARGET, so it must be an absolute path below / that is not the running
# system itself (the live medium) nor one of its core directories.
guard_target() {
  local t="$TARGET" canon
  [ -n "$t" ] || die "--target must not be empty"
  case "$t" in
    /*) ;;
    *)  die "--target must be an absolute path below / (got '$t')" ;;
  esac

  canon="$(readlink -f -- "$t" 2>/dev/null)"
  [ -n "$canon" ] || canon="$(_lexical_realpath "$t")"
  case "$canon" in
    /)  ;;
    */) canon="${canon%/}" ;;
  esac

  [ "$canon" != "/" ] \
    || die "--target must not be the running system root (/)"
  case "$canon" in
    /usr|/bin|/sbin|/lib|/lib32|/lib64|/libexec|/etc|/boot|/efi|/var|/dev|/proc|/sys|/run|/root|/home|/srv|/opt)
      die "--target must not be a running-system directory ($canon)" ;;
  esac
}

run_check() {
  say "voidc $VOIDC_VERSION — environment check"
  detect_environment
  printf '  %-22s %s\n' "firmware:"   "$([ "$UEFI" = yes ] && echo 'UEFI' || echo 'BIOS')"
  printf '  %-22s %s\n' "arch/libc:"  "$XBPS_ARCH ($LIBC)"
  printf '  %-22s %s\n' "ram:"         "${RAM_MB} MiB"
  printf '  %-22s %s\n' "microcode:"   "${UCODE[*]:-none}"
  printf '  %-22s %s\n' "xbps-install:" "$(command -v xbps-install >/dev/null 2>&1 && echo yes || echo NO)"
  printf '  %-22s %s\n' "dialog:"      "$(command -v dialog >/dev/null 2>&1 && echo yes || echo NO)"
  printf '  %-22s %s\n' "parted:"      "$(command -v parted >/dev/null 2>&1 && echo yes || echo NO)"
  printf '  %-22s %s\n' "cryptsetup:"  "$(command -v cryptsetup >/dev/null 2>&1 && echo yes || echo NO)"
  printf '  %-22s %s\n' "target ($TARGET):" "$(findmnt -rn "$TARGET" >/dev/null 2>&1 && echo 'mounted' || echo 'free')"
  echo
  echo "  disks:"
  local disks; disks="$(list_disks)"
  if [ -z "$disks" ]; then
    echo "    (none found — is this the Void live ISO? check firmware/storage mode)"
  else
    printf '%s\n' "$disks" | sed 's/^/    /'
  fi
  echo
  printf '  %-22s ' "default mirror:"
  if ! command -v curl >/dev/null 2>&1; then echo "unknown (curl missing)"; \
  elif mirror_reachable "$DEFAULT_MIRROR"; then echo "reachable"; else echo "NOT reachable (check network)"; fi
  printf '  %-22s ' "fastest mirror:"
  local fastest; fastest="$(pick_fastest_mirror)"
  echo "${fastest:-none found}"
  echo
  log "check run: uefi=$UEFI arch=$XBPS_ARCH libc=$LIBC"
  return 0
}

# ------------------------------------------------------------------- main ---
MODE=wizard
AUTO_CFG=""
ORIG_ARGS=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    --auto)    MODE=auto; AUTO_CFG="${2:-}"; [ -n "$AUTO_CFG" ] || die "--auto needs a profile file"; shift 2 ;;
    --target)  TARGET="${2:-}"; [ -n "$TARGET" ] || die "--target needs a directory"; shift 2 ;;
    --check)   MODE=check; shift ;;
    -h|--help) usage; exit 0 ;;
    -v|--version) echo "voidc $VOIDC_VERSION"; exit 0 ;;
    *) usage; die "Unknown argument: $1" ;;
  esac
done

# never let a bad --target wipe the running system or write outside the root
guard_target

log "voidc $VOIDC_VERSION started (mode=$MODE target=$TARGET)"

if [ "$MODE" != check ] && [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null 2>&1; then
    if [ "${#ORIG_ARGS[@]}" -gt 0 ]; then
      exec sudo "$0" "${ORIG_ARGS[@]}"
    else
      exec sudo "$0"
    fi
  fi
  die "Please run as root."
fi

case "$MODE" in
  check)  run_check ;;
  auto)   run_auto "$AUTO_CFG" ;;
  wizard) run_wizard ;;
esac
